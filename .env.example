# Project identity — the ONE value to change when starting a new project from
# this skeleton. Compose derives container names from it, and docker-compose.yml
# builds the php/node image tags from it. Lowercase, no spaces.
COMPOSE_PROJECT_NAME=app

# Ports
NGINX_PORT=8000
NGINX_FRONT_PORT=8080
DB_PORT=5432
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
QUASAR_PORT=9200

# Database
DB_DATABASE=forest
DB_USERNAME=forest
DB_PASSWORD=secret

# Mail (MailHog for local dev)
MAIL_FROM_ADDRESS=noreply@forest.local
MAIL_FROM_NAME=Forest

# Cloudflare Turnstile
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Social Auth — Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8000/api/auth/google/callback

# Social Auth — Facebook
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URL=http://localhost:8000/api/auth/facebook/callback

# Social Auth — GitHub (optional)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URL=http://localhost:8000/api/auth/github/callback

# Frontend URL (used for OTP email links / CORS)
FRONTEND_URL=http://localhost:9200
